---
// src/pages/index.astro
// Custom homepage - overrides Starlight's default splash

import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const allTerms = await getCollection('docs', (e) => e.id.startsWith('terms/'));
const allPaths = await getCollection('docs', (e) => e.id.startsWith('paths/'));
const allModules = await getCollection('docs', (e) => e.id.startsWith('modules/'));

const termCount = allTerms.length;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage frontmatter={{ title: 'Maximo Field Guide', template: 'splash' }}>
  <div class="not-content home-grid-bg">
    <div class="home-header">
      <h1 style="font-size: 2rem; margin: 0; font-weight: 700;">Maximo Field Guide</h1>
      <p class="home-tagline">Plain-English Maximo, explained through one real-feeling utility.</p>
      <span class="home-community-note">Community draft. Practitioner review in progress.</span>
      <div class="home-stat">{termCount} terms across 14 modules and 6 learning paths.</div>
    </div>
  </div>

  <div class="not-content home-section">
    <h2>Learning Paths</h2>
    <ul class="path-list">
      {allPaths
        .sort((a, b) => (a.data.pathSlug || '').localeCompare(b.data.pathSlug || ''))
        .map((path) => (
          <li>
            <a href={`${BASE}/paths/${path.data.pathSlug}/`}>{path.data.pathName}</a>
            <span class="path-steps">{path.data.stepCount} steps</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="not-content home-section">
    <h2>Modules</h2>
    <ul class="module-list">
      {allModules
        .sort((a, b) => (a.data.moduleName || '').localeCompare(b.data.moduleName || ''))
        .map((mod) => (
          <li>
            <div>
              <a href={`${BASE}/modules/${mod.data.moduleSlug}/`}>{mod.data.moduleName}</a>
              <span class="module-term-count" style="margin-left: 0.5rem;">{mod.data.termCount} terms</span>
            </div>
            {mod.data.whatItCovers && (
              <div class="module-list-desc">{mod.data.whatItCovers}</div>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="not-content home-section">
    <h2>Riverbend Water Authority</h2>
    <p>
      Every example in this guide uses Riverbend Water Authority, a fictional municipal water utility.
      RWA has one organization, three sites, real-looking assets and work orders, and all the data
      you need to follow each concept from start to finish.
    </p>
    <a href={`${BASE}/riverbend/`} style="color: var(--mfg-accent); font-weight: 500;">
      Meet Riverbend Water &rarr;
    </a>
  </div>
</StarlightPage>
